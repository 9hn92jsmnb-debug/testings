local function findReloadCoverPoint(data: NPCData, targetHRP: BasePart): Vector3?
	local rootPos = data.root.Position
	local targetPos = targetHRP.Position
	local ignoreList = { data.npc, targetHRP.Parent }

	local candidateDirections = {
		Vector3.new(1, 0, 0),
		Vector3.new(-1, 0, 0),
		Vector3.new(0, 0, 1),
		Vector3.new(0, 0, -1),
		Vector3.new(1, 0, 1).Unit,
		Vector3.new(-1, 0, 1).Unit,
		Vector3.new(1, 0, -1).Unit,
		Vector3.new(-1, 0, -1).Unit,
	}

	local awayFromTarget = rootPos - targetPos
	if awayFromTarget.Magnitude > 0.001 then
		table.insert(candidateDirections, awayFromTarget.Unit)
	end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = ignoreList
	rayParams.IgnoreWater = true

	local downParams = RaycastParams.new()
	downParams.FilterType = Enum.RaycastFilterType.Exclude
	downParams.FilterDescendantsInstances = ignoreList
	downParams.IgnoreWater = true

	local bestPoint: Vector3? = nil
	local bestScore = -math.huge

	for _, direction in candidateDirections do
		for _, distance in { RELOAD_COVER_DISTANCE, RELOAD_COVER_DISTANCE + 6, RELOAD_COVER_DISTANCE + 12 } do
			local flatDir = Vector3.new(direction.X, 0, direction.Z)
			if flatDir.Magnitude <= 0.001 then
				continue
			end

			local candidate = rootPos + flatDir.Unit * distance
			local groundHit = Workspace:Raycast(candidate + Vector3.new(0, 12, 0), Vector3.new(0, -30, 0), downParams)
			if groundHit then
				candidate = Vector3.new(candidate.X, groundHit.Position.Y + 2.5, candidate.Z)
			end

			local toCandidate = candidate - targetPos
			local sightHit = Workspace:Raycast(targetPos + Vector3.new(0, 2, 0), toCandidate, rayParams)
			local hasOcclusion = sightHit ~= nil and (sightHit.Position - candidate).Magnitude > 1.5
			if hasOcclusion then
				local fartherFromTarget = (candidate - targetPos).Magnitude - (rootPos - targetPos).Magnitude
				local closerForNPC = -(candidate - rootPos).Magnitude
				local score = fartherFromTarget * 2 + closerForNPC
				if score > bestScore then
					bestScore = score
					bestPoint = candidate
				end
			end
		end
	end

	return bestPoint
end

local function runToReloadCover(data: NPCData, targetHRP: BasePart?): boolean
	if not targetHRP then
		return false
	end

	local coverPoint = findReloadCoverPoint(data, targetHRP)
	if not coverPoint then
		local away = data.root.Position - targetHRP.Position
		if away.Magnitude <= 0.001 then
			return false
		end
		coverPoint = data.root.Position + away.Unit * (RELOAD_COVER_DISTANCE + 6)
	end

	data.reloadCoverPoint = coverPoint
	data.reloadCoverUntil = now() + RELOAD_COVER_TIMEOUT
	data.reloadPending = true
	return true
end

local function isAimingOrReloadState(state: string): boolean
	return state == "Hold_Idle"
		or state == "Initiate"
		or state == "Unitiate"
		or state == "Fire"
		or state == "Reload"
end

local function setRigForAnimation(data: NPCData, animationName: string)
	local meta = data.animationMeta[animationName]
	if not meta then
		return
	end

	if meta.isViewmodel then
		data.npc:SetAttribute("ViewmodelEnabled", true)
		applyViewmodelMotorState(resolveViewmodelState(data.npc), data.npc)
	else
		data.npc:SetAttribute("ViewmodelEnabled", false)
		applyNormalMotorState(data.npc)
	end
end

local function isMeleeAnimation(animationName: string): boolean
	return string.sub(animationName, 1, 5) == "Melee"
end

local function resolveTrack(cache, path)
	local node = cache
	local segments = {}

	for seg in string.gmatch(path, "[^%.]+") do
		table.insert(segments, seg)
		if type(node) ~= "table" then break end
		node = node[seg]
	end

	if typeof(node) == "Instance" then
		return node
	end

	local last = segments[#segments]
	if not last then return nil end

	local function search(tbl)
		for k,v in pairs(tbl) do
			if typeof(v) == "Instance" then
				if k == last or string.lower(k):find(string.lower(last),1,true) then
					return v
				end
			elseif type(v) == "table" then
				local f = search(v)
				if f then return f end
			end
		end
	end

	return search(cache)
end
local function playState(data: NPCData, animationName: string, nextState: string?, force: boolean?)
	local shouldForce = force == true
	if not shouldForce and data.state == animationName and data.currentTrack and data.currentTrack.IsPlaying then
		return
	end

	local track = resolveTrack(data.animationCache, animationName)

	if not track then
		warn("Missing animation: " .. animationName)
		return
	end

	if data.currentTrack and data.currentTrack.IsPlaying then
		data.currentTrack:Stop(if shouldForce then 0 else 0.15)
	end

	setRigForAnimation(data, animationName)

	data.state = animationName
	data.currentTrack = track
	track:Play(if shouldForce then 0 else 0.15)
	if isMeleeAnimation(animationName) then
		track:AdjustSpeed(MELEE_TRACK_SPEED)
	else
		track:AdjustSpeed(1)
	end

	if nextState then
		local thisTrack = track
		task.spawn(function()
			thisTrack.Stopped:Wait()
			if data.currentTrack == thisTrack then
				if data.meleeMode and not isMeleeAnimation(nextState) then
					return
				end
				playState(data, nextState)
			end
		end)
	end
end
