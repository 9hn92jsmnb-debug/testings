local function resolveConfigFromModel(npc: Model): NPCConfig
	local existing = CONFIG[npc]
	if existing then
		return existing
	end
	local cfg = cloneConfig()
	local configModule = npc:FindFirstChild("Config")
	if configModule and configModule:IsA("ModuleScript") then
		local ok, loaded = pcall(require, configModule)
		if ok and type(loaded) == "table" then
			local combat = loaded.Combat
			if type(combat) == "table" then
				if combat.SightRange ~= nil then cfg.Combat.SightRange = combat.SightRange end
				if combat.ShootRange ~= nil then cfg.Combat.ShootRange = combat.ShootRange end
				if combat.FireInterval ~= nil then cfg.Combat.FireInterval = combat.FireInterval end
				if combat.BulletSpeed ~= nil then cfg.Combat.BulletSpeed = combat.BulletSpeed end
				if combat.BulletLife ~= nil then cfg.Combat.BulletLife = combat.BulletLife end
				if combat.BulletDamageMin ~= nil then cfg.Combat.BulletDamageMin = combat.BulletDamageMin end
				if combat.BulletDamageMax ~= nil then cfg.Combat.BulletDamageMax = combat.BulletDamageMax end
				if combat.MagazineSize ~= nil then cfg.Combat.MagazineSize = combat.MagazineSize end
				if combat.ReloadDuration ~= nil then cfg.Combat.ReloadDuration = combat.ReloadDuration end
				if combat.BulletDrop ~= nil then cfg.Combat.BulletDrop = combat.BulletDrop end
			end
			local movement = loaded.Movement
			if type(movement) == "table" then
				if movement.WalkSpeed ~= nil then cfg.Movement.WalkSpeed = movement.WalkSpeed end
				if movement.KickRange ~= nil then cfg.Movement.KickRange = movement.KickRange end
				if movement.PathUpdateInterval ~= nil then cfg.Movement.PathUpdateInterval = movement.PathUpdateInterval end
			end
			local perception = loaded.Perception
			if type(perception) == "table" then
				if perception.TargetRefreshInterval ~= nil then cfg.Perception.TargetRefreshInterval = perception.TargetRefreshInterval end
				if perception.GrenadeCheckRadius ~= nil then cfg.Perception.GrenadeCheckRadius = perception.GrenadeCheckRadius end
			end
			local animations = loaded.Animations
			if type(animations) == "table" then
				if animations.Idle ~= nil then cfg.Animations.Idle = animations.Idle end
				if animations.Walk ~= nil then cfg.Animations.Walk = animations.Walk end
				if type(animations.Shoot) == "table" and #animations.Shoot > 0 then cfg.Animations.Shoot = animations.Shoot end
				if animations.Reload ~= nil then cfg.Animations.Reload = animations.Reload end
			end
			local audio = loaded.Audio
			if type(audio) == "table" then
				if audio.ShootSoundName ~= nil then cfg.Audio.ShootSoundName = audio.ShootSoundName end
			end
			local debugCfg = loaded.Debug
			if type(debugCfg) == "table" then
				if debugCfg.VisualizePath ~= nil then cfg.Debug.VisualizePath = debugCfg.VisualizePath end
			end
			local rotation = loaded.Rotation
			if type(rotation) == "table" then
				if rotation.Enabled ~= nil then cfg.Rotation.Enabled = rotation.Enabled end
				if rotation.P ~= nil then cfg.Rotation.P = rotation.P end
				if rotation.D ~= nil then cfg.Rotation.D = rotation.D end
				if rotation.MaxTorque ~= nil then cfg.Rotation.MaxTorque = rotation.MaxTorque end
			end
		end
	end
	CONFIG[npc] = cfg
	return cfg
end

