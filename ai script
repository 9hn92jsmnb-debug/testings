local function parseAnimationSpec(spec: any): AnimationMeta
	if type(spec) == "string" then
		return { id = spec, isViewmodel = false }
	end

	if type(spec) == "table" then
		local id = spec[1] or spec.id or spec.AnimationId
		local isViewmodel = spec[2]
		if isViewmodel == nil then
			isViewmodel = spec.isViewmodel or spec.Viewmodel or spec.IsViewmodel
		end
		if type(id) == "string" then
			return {
				id = id,
				isViewmodel = isViewmodel == true,
			}
		end
	end

	error("Invalid animation config. Expected string or {id, isViewmodel}.")
end

local function loadconfig(npc: Model, animator: Animator): ({[string]: any}, {[string]: any})
	local configModule = npc:FindFirstChild("Config")
	if not configModule or not configModule:IsA("ModuleScript") then
		error("initializeNPC: missing Config ModuleScript")
	end

	local config = require(configModule) :: NPCConfig
	local animations = config.Animations
	if not animations then
		error("initializeNPC: Config missing Animations table")
	end

	local animationCache = {}
	local animationMeta = {}

	local function loadTable(tbl)
		local cache = {}
		local metaTbl = {}

		for animationName, animationSpec in pairs(tbl) do
			if type(animationSpec) == "table" and animationSpec[1] == nil then
				cache[animationName], metaTbl[animationName] = loadTable(animationSpec)
			else
				local meta = parseAnimationSpec(animationSpec)
				local animation = Instance.new("Animation")
				animation.Name = animationName
				animation.AnimationId = meta.id
				cache[animationName] = animator:LoadAnimation(animation)
				metaTbl[animationName] = meta
			end
		end

		return cache, metaTbl
	end

	animationCache, animationMeta = loadTable(animations)

	return animationCache, animationMeta
end
local function loadstats(data: NPCData)
	local configModule = data.npc:FindFirstChild("Config")
	if not configModule or not configModule:IsA("ModuleScript") then
		return
	end

	local ok, config = pcall(require, configModule)
	if not ok or type(config) ~= "table" then
		return
	end

	local configs = config.Configurations
	if type(configs) ~= "table" then
		return
	end

	for statName, value in pairs(configs) do
		data[statName] = value
		print(value)
	end
end
local function getNeckMotor(npc: Model): Motor6D?
	local head = npc:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		local headNeck = head:FindFirstChild("Neck")
		if headNeck and headNeck:IsA("Motor6D") then
			return headNeck
		end
	end

	local upperTorso = npc:FindFirstChild("UpperTorso")
	if upperTorso and upperTorso:IsA("BasePart") then
		local neck = upperTorso:FindFirstChild("Neck")
		if neck and neck:IsA("Motor6D") then
			return neck
		end
	end

	local torso = npc:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		local neck = torso:FindFirstChild("Neck")
		if neck and neck:IsA("Motor6D") then
			return neck
		end
	end

	return nil
end

local function resolveViewmodelState(npc: Model): ViewmodelState
	local data = REG[npc]
	if not data then
		return {
			stateType = "normal",
			isViewmodelEnabled = false,
			isHeadDisabled = false,
			isLeftArmDisabled = false,
		}
	end

	local vmEnabled = data.npc:GetAttribute("ViewmodelEnabled") == true
	local tool = data.gun and data.gun.Value
	local disableNow = tool and tool:GetAttribute("_DisableNow") == true

	return {
		stateType = if vmEnabled and data.humanoid.Health > 0 then "viewmodel" else "normal",
		isViewmodelEnabled = vmEnabled,
		isHeadDisabled = if disableNow and tool then tool:GetAttribute("_DisableHead") == true else false,
		isLeftArmDisabled = if disableNow and tool then tool:GetAttribute("_DisableLeftArm") == true else false,
	}
end

local function getTorsoMotor6Ds(torso: BasePart): {[string]: Motor6D}
	local torsoMotor6Ds: {[string]: Motor6D} = {}
	for _, motor6D in torso:GetChildren() do
		if motor6D:IsA("Motor6D") then
			torsoMotor6Ds[motor6D.Name] = motor6D
		end
	end
	return torsoMotor6Ds
end

local function applyViewmodelMotorState(state: ViewmodelState, npc: Model)
	local data = REG[npc]
	if not data then
		return
	end

	local torso = data.npc:FindFirstChild("Torso")
	local vm = data.npc:FindFirstChild("Viewmodel")
	if not torso or not torso:IsA("BasePart") or not vm then
		return
	end

	local tool = data.gun and data.gun.Value
	local torsoMotor6Ds = getTorsoMotor6Ds(torso)

	if torsoMotor6Ds["GunMotor6D"] then
		torsoMotor6Ds["GunMotor6D"].Enabled = false
	end
	if torsoMotor6Ds["MeleeMotor6D"] then
		torsoMotor6Ds["MeleeMotor6D"].Enabled = false
	end
	if torso:FindFirstChild("Right Shoulder") then
		(torso["Right Shoulder"] :: Motor6D).Enabled = false
	end

	if tool and tool:GetAttribute("_DisableNow") == true then
		if vm:FindFirstChild("LeftArm") then
			(vm.LeftArm :: Motor6D).Enabled = not state.isLeftArmDisabled
		end
		if vm:FindFirstChild("vm_Head") then
			(vm.vm_Head :: Motor6D).Enabled = not state.isHeadDisabled
		end
		if torso:FindFirstChild("Left Shoulder") then
			(torso["Left Shoulder"] :: Motor6D).Enabled = state.isLeftArmDisabled
		end
	else
		if torso:FindFirstChild("Left Shoulder") then
			(torso["Left Shoulder"] :: Motor6D).Enabled = false
		end
		if vm:FindFirstChild("LeftArm") then
			(vm.LeftArm :: Motor6D).Enabled = true
		end
		if vm:FindFirstChild("vm_Head") then
			(vm.vm_Head :: Motor6D).Enabled = true
		end
	end

	if vm:FindFirstChild("vm_GunMotor6D") then
		(vm.vm_GunMotor6D :: Motor6D).Enabled = true
	end
	if vm:FindFirstChild("RightArm") then
		(vm.RightArm :: Motor6D).Enabled = true
	end
	if torso:FindFirstChild("Neck") then
		(torso["Neck"] :: Motor6D).Enabled = false
	end
end

