local function getAnimator(humanoid: Humanoid): Animator
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		return animator
	end
	animator = Instance.new("Animator")
	animator.Parent = humanoid
	return animator
end

local function canSeeTarget(npc: Model, fromPart: BasePart, targetCharacter: Model): boolean
	local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter:FindFirstChild("Head")
	if not targetRoot or not targetRoot:IsA("BasePart") then
		return false
	end
	local direction = targetRoot.Position - fromPart.Position
	local distance = direction.Magnitude
	if distance <= 0 then
		return true
	end
	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = {npc}
	raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
	local result = workspace:Raycast(fromPart.Position, direction.Unit * distance, raycastParams)
	if not result then
		return true
	end
	return result.Instance:IsDescendantOf(targetCharacter)
end

local function getNearestEnemy(context: NPCContext)
	local nearestCharacter: Model? = nil
	local nearestDistance = math.huge
	local config = resolveConfigFromModel(context.npc)
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		if not character or character == context.npc then
			continue
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")
		local cloaked = character:FindFirstChild("Cloaked")
		local corp = character:FindFirstChild("Corporation")
		if not humanoid or humanoid.Health <= 0 or not root then
			continue
		end
		if cloaked and cloaked:IsA("BoolValue") and cloaked.Value then
			continue
		end
		if corp and corp:IsA("BoolValue") and corp.Value then
			continue
		end
		local dist = (root.Position - context.root.Position).Magnitude
		if dist < nearestDistance and dist <= config.Combat.SightRange then
			nearestDistance = dist
			nearestCharacter = character
		end
	end
	return nearestCharacter, nearestDistance
end

local function setState(context: NPCContext, nextState: string, force: boolean?)
	if context.state == nextState and not force then
		return
	end
	context.state = nextState
	local config = resolveConfigFromModel(context.npc)
	if context.currentTrack then
		context.currentTrack:Stop(0.15)
		context.currentTrack = nil
	end
	local animId: string? = nil
	if nextState == "Idle" then
		animId = config.Animations.Idle
	elseif nextState == "Walk" then
		animId = config.Animations.Walk
	elseif nextState == "Shoot" then
		animId = config.Animations.Shoot[math.random(1, #config.Animations.Shoot)]
	elseif nextState == "Reload" then
		animId = config.Animations.Reload
	end
	if not animId then
		return
	end
	local animTrack = context.animationCache[animId]
	if not animTrack then
		local animation = Instance.new("Animation")
		animation.AnimationId = animId
		animTrack = context.animator:LoadAnimation(animation)
		context.animationCache[animId] = animTrack
	end
	animTrack.Priority = (nextState == "Shoot" or nextState == "Reload") and Enum.AnimationPriority.Action or Enum.AnimationPriority.Movement
	animTrack.Looped = nextState ~= "Reload"
	animTrack:Play(0.15)
	context.currentTrack = animTrack
	if nextState == "Reload" then
		task.delay(animTrack.Length, function()
			if REG[context.npc] ~= context then
				return
			end
			context.ammo = 0
			context.reloading = false
			setState(context, "Idle")
		end)
	end
end

local function fireAtTarget(context: NPCContext, targetRoot: BasePart)
	if context.reloading then
		return
	end
	local config = resolveConfigFromModel(context.npc)
	if context.ammo >= config.Combat.MagazineSize then
		context.reloading = true
		setState(context, "Reload")
		return
	end
	if os.clock() - context.lastShotTime < config.Combat.FireInterval then
		return
	end
	context.lastShotTime = os.clock()
	context.ammo += 1
	setState(context, "Shoot")
	local weapon = context.npc:FindFirstChild("Gun").Value
	if weapon and weapon:IsA("BasePart") then
		local shootSound = weapon:FindFirstChild(config.Audio.ShootSoundName)
		if shootSound and shootSound:IsA("Sound") then
			shootSound:Play()
		end
		local bullet = Instance.new("Part")
		bullet.Name = "NPCBullet"
		bullet.Size = Vector3.new(0.3, 0.3, 3.5)
		bullet.Material = Enum.Material.Neon
		bullet.CanCollide = false
		bullet.CFrame = CFrame.new(weapon.Position, targetRoot.Position)
		bullet.Parent = context.npc
		Util.ApplyBallistics(bullet, config.Combat.BulletSpeed, 55, config.Combat.BulletDrop, "X")
		local hitConnection
		hitConnection = bullet.Touched:Connect(function(hit)
			if not hit or not hit.Parent then
				return
			end
			if hit:IsDescendantOf(context.npc) then
				return
			end
			local victimHumanoid = hit.Parent:FindFirstChildOfClass("Humanoid")
			if victimHumanoid then
				victimHumanoid:TakeDamage(math.random(config.Combat.BulletDamageMin, config.Combat.BulletDamageMax))
			end
			if hitConnection then
				hitConnection:Disconnect()
			end
			bullet:Destroy()
		end)
		Debris:AddItem(bullet, config.Combat.BulletLife)
	end
end

local function updateBodyGyro(context: NPCContext, targetPosition: Vector3)
	local bodyGyro = context.bodyGyro
	if not bodyGyro then
		return
	end
	local lookAt = Vector3.new(targetPosition.X, context.root.Position.Y, targetPosition.Z)
	bodyGyro.CFrame = CFrame.new(context.root.Position, lookAt)
end

local function updateOneNPC(context: NPCContext, dt: number)
	if not context.npc.Parent or context.humanoid.Health <= 0 then
		REG[context.npc] = nil
		CONFIG[context.npc] = nil
		return
	end
	local config = resolveConfigFromModel(context.npc)
	context.pathAccumulator += dt
	context.targetAccumulator += dt
	local flashed = context.flashTag and context.flashTag.Value
	if flashed then
		context.humanoid.WalkSpeed = 0
		context.path:Stop()
		setState(context, "Idle")
		return
	else
		context.humanoid.WalkSpeed = config.Movement.WalkSpeed
	end
	if context.targetAccumulator >= config.Perception.TargetRefreshInterval then
		context.targetAccumulator = 0
		context.target = getNearestEnemy(context)
	end
	local targetCharacter = context.target
	if not targetCharacter then
		context.path:Stop()
		setState(context, "Idle")
		return
	end
	local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
	local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
	if not targetRoot or not targetHumanoid or targetHumanoid.Health <= 0 then
		context.target = nil
		context.path:Stop()
		setState(context, "Idle")
		return
	end
	local distance = (targetRoot.Position - context.root.Position).Magnitude
	local canSee = canSeeTarget(context.npc, context.head, targetCharacter)
	updateBodyGyro(context, targetRoot.Position)
	if distance <= config.Combat.ShootRange and canSee then
		context.path:Stop()
		fireAtTarget(context, targetRoot)
		return
	end
	if context.pathAccumulator >= config.Movement.PathUpdateInterval then
		context.pathAccumulator = 0
		context.path:Run(targetRoot.Position)
	end
	setState(context, "Walk")
end

local function ensureHeartbeat()
	if HEARTBEAT_CONNECTION then
		return
	end
	HEARTBEAT_CONNECTION = RunService.Heartbeat:Connect(function(dt)
		for _, context in pairs(REG) do
			updateOneNPC(context, dt)
		end
		if next(REG) == nil and HEARTBEAT_CONNECTION then
			HEARTBEAT_CONNECTION:Disconnect()
			HEARTBEAT_CONNECTION = nil
		end
	end)
end

local function handleNPCDeath(npc: Model, humanoid: Humanoid)
	REG[npc] = nil
	CONFIG[npc] = nil
	if npc:FindFirstChild("Health") and npc.Health:IsA("Script") then
		npc.Health.Disabled = true
	end
	humanoid.Archivable = true
	local zombiecorpse = npc:Clone()
	local weldConstraints = {}
	for _, weld in ipairs(zombiecorpse:GetDescendants()) do
		if weld:IsA("WeldConstraint") then
			table.insert(weldConstraints, {weld = weld, part0 = weld.Part0, part1 = weld.Part1})
		end
	end
	for _, descendant in ipairs(zombiecorpse:GetDescendants()) do
		if (descendant:IsA("Script") or descendant:IsA("LocalScript")) and descendant.Name ~= "balls" then
			descendant:Destroy()
		end
	end
	npc:Destroy()
	for _, data in ipairs(weldConstraints) do
		if data.part0 and data.part1 then
			data.weld.Part0 = data.part0
			data.weld.Part1 = data.part1
			data.weld.Enabled = true
		end
	end
	zombiecorpse.Parent = workspace
	Debris:AddItem(zombiecorpse, 15)
	local corpseHumanoid = zombiecorpse:FindFirstChildOfClass("Humanoid")
	local torso = zombiecorpse:FindFirstChild("Torso")
	if not corpseHumanoid or not torso or not torso:IsA("BasePart") then
		return
	end
	corpseHumanoid.PlatformStand = true
	corpseHumanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	for _, v in pairs(torso:GetChildren()) do
		if v:IsA("Motor6D") or v:IsA("Weld") then
			v:Destroy()
		end
	end
	local head = zombiecorpse:FindFirstChild("Head")
	if head then
		for _, v in pairs(head:GetChildren()) do
			if v:IsA("Weld") then
				v:Destroy()
			end
		end
	end
	for _, v in pairs(zombiecorpse:GetChildren()) do
		if v:IsA("Part") then
			for _, w in pairs(v:GetChildren()) do
				if w:IsA("BodyPosition") or w:IsA("BodyVelocity") then
					w:Destroy()
				end
			end
		end
	end
	local function makeconnections(limb: BasePart, attachementone: Attachment, attachmenttwo: Attachment, twistlower: number, twistupper: number)
		local connection = Instance.new("BallSocketConstraint", limb)
		connection.LimitsEnabled = true
		connection.Attachment0 = attachementone
		connection.Attachment1 = attachmenttwo
		connection.TwistLimitsEnabled = true
		connection.TwistLowerAngle = twistlower
		connection.TwistUpperAngle = twistupper
		connection.UpperAngle = 70
	end
	local function makehingeconnections(limb: BasePart, attachementone: Attachment, attachmenttwo: Attachment, twistlower: number, twistupper: number)
		local connection = Instance.new("HingeConstraint", limb)
		connection.Attachment0 = attachementone
		connection.Attachment1 = attachmenttwo
		connection.LimitsEnabled = true
		connection.LowerAngle = twistlower
		connection.UpperAngle = twistupper
	end
	local rightArm = zombiecorpse:FindFirstChild("Right Arm")
	local leftArm = zombiecorpse:FindFirstChild("Left Arm")
	local rightLeg = zombiecorpse:FindFirstChild("Right Leg")
	local leftLeg = zombiecorpse:FindFirstChild("Left Leg")
	if rightArm and rightArm:IsA("BasePart") and rightArm:FindFirstChild("RightShoulderAttachment") and torso:FindFirstChild("RightCollarAttachment") then
		rightArm.RightShoulderAttachment.Position = Vector3.new(0, 0.5, 0)
		torso.RightCollarAttachment.Position = Vector3.new(1.5, 0.5, 0)
	end
	if leftArm and leftArm:IsA("BasePart") and leftArm:FindFirstChild("LeftShoulderAttachment") and torso:FindFirstChild("LeftCollarAttachment") then
		leftArm.LeftShoulderAttachment.Position = Vector3.new(0, 0.5, 0)
		torso.LeftCollarAttachment.Position = Vector3.new(-1.5, 0.5, 0)
	end
	if rightLeg and rightLeg:IsA("BasePart") then
		local rightLegAttachment = Instance.new("Attachment", rightLeg)
		rightLegAttachment.Position = Vector3.new(0, 1, 0)
		local torsoRightLegAttachment = Instance.new("Attachment", torso)
		torsoRightLegAttachment.Position = Vector3.new(0.5, -1, 0)
		makeconnections(rightLeg, rightLegAttachment, torsoRightLegAttachment, -80, 80)
	end
	if leftLeg and leftLeg:IsA("BasePart") then
		local leftLegAttachment = Instance.new("Attachment", leftLeg)
		leftLegAttachment.Position = Vector3.new(0, 1, 0)
		local torsoLeftLegAttachment = Instance.new("Attachment", torso)
		torsoLeftLegAttachment.Position = Vector3.new(-0.5, -1, 0)
		makeconnections(leftLeg, leftLegAttachment, torsoLeftLegAttachment, -80, 80)
	end
	if head and head:IsA("BasePart") and torso:FindFirstChild("NeckAttachment") then
		local headAttachment = Instance.new("Attachment", head)
		headAttachment.Position = Vector3.new(0, -0.5, 0)
		makehingeconnections(head, headAttachment, torso.NeckAttachment, -20, 20)
	end
	if rightArm and rightArm:IsA("BasePart") and rightArm:FindFirstChild("RightShoulderAttachment") and torso:FindFirstChild("RightCollarAttachment") then
		makeconnections(rightArm, rightArm.RightShoulderAttachment, torso.RightCollarAttachment, -80, 80)
		local limbcollider = Instance.new("Part", rightArm)
		limbcollider.Size = Vector3.new(1, 1.3, 1)
		limbcollider.Shape = Enum.PartType.Cylinder
		limbcollider.Transparency = 1
		local limbcolliderweld = Instance.new("Weld", limbcollider)
		limbcolliderweld.Part0 = rightArm
		limbcolliderweld.Part1 = limbcollider
		limbcolliderweld.C0 = CFrame.fromEulerAnglesXYZ(0, 0, math.pi / 2) * CFrame.new(-0.4, 0, 0)
		for _, v in pairs(rightArm:GetChildren()) do
			if v:IsA("Motor6D") or v:IsA("Weld") then
				v:Destroy()
			end
		end
	end
	if leftArm and leftArm:IsA("BasePart") and leftArm:FindFirstChild("LeftShoulderAttachment") and torso:FindFirstChild("LeftCollarAttachment") then
		makeconnections(leftArm, leftArm.LeftShoulderAttachment, torso.LeftCollarAttachment, -80, 80)
		local limbcollider = Instance.new("Part", leftArm)
		limbcollider.Size = Vector3.new(1, 1.3, 1)
		limbcollider.Shape = Enum.PartType.Cylinder
		limbcollider.Transparency = 1
		local limbcolliderweld = Instance.new("Weld", limbcollider)
		limbcolliderweld.Part0 = leftArm
		limbcolliderweld.Part1 = limbcollider
		limbcolliderweld.C0 = CFrame.fromEulerAnglesXYZ(0, 0, math.pi / 2) * CFrame.new(-0.4, 0, 0)
	end
	if leftLeg and leftLeg:IsA("BasePart") then
		local limbcollider = Instance.new("Part", leftLeg)
		limbcollider.Size = Vector3.new(1, 1.3, 1)
		limbcollider.Shape = Enum.PartType.Cylinder
		limbcollider.Transparency = 1
		local limbcolliderweld = Instance.new("Weld", limbcollider)
		limbcolliderweld.Part0 = leftLeg
		limbcolliderweld.Part1 = limbcollider
		limbcolliderweld.C0 = CFrame.fromEulerAnglesXYZ(0, 0, math.pi / 2) * CFrame.new(-0.4, 0, 0)
	end
	if rightLeg and rightLeg:IsA("BasePart") then
		local limbcollider = Instance.new("Part", rightLeg)
		limbcollider.Size = Vector3.new(1, 1.3, 1)
		limbcollider.Shape = Enum.PartType.Cylinder
		limbcollider.Transparency = 1
		local limbcolliderweld = Instance.new("Weld", limbcollider)
		limbcolliderweld.Part0 = rightLeg
		limbcolliderweld.Part1 = limbcollider
		limbcolliderweld.C0 = CFrame.fromEulerAnglesXYZ(0, 0, math.pi / 2) * CFrame.new(-0.4, 0, 0)
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if assets and assets:FindFirstChild("Items") then
		local m16 = assets.Items:FindFirstChild("M16")
		if m16 and m16:IsA("Tool") then
			local clone = m16:Clone()
			clone.Parent = workspace
			for _, part in ipairs(clone:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Anchored = false
					part.CanCollide = true
					part.Position = torso.Position + Vector3.new(0, 2, 0)
				end
			end
		end
	end
	if zombiecorpse:FindFirstChild("HumanoidRootPart") and zombiecorpse.HumanoidRootPart:IsA("BasePart") then
		zombiecorpse.HumanoidRootPart.CanCollide = false
		zombiecorpse.HumanoidRootPart:Destroy()
	end
end

local function registerNPC(npc: Model)
	if REG[npc] then
		return
	end
	local humanoid = npc:FindFirstChildOfClass("Humanoid")
	local root = npc:FindFirstChild("HumanoidRootPart")
	local head = npc:FindFirstChild("Head")
	if not humanoid or not root or not head then
		warn("NPC missing required parts:", npc:GetFullName())
		return
	end
	local config = resolveConfigFromModel(npc)
	local path = SimplePath.new(npc)
	path.Visualize = config.Debug.VisualizePath
	local bodyGyro: BodyGyro? = nil
	if config.Rotation.Enabled then
		bodyGyro = Instance.new("BodyGyro")
		bodyGyro.Name = "NPCBodyGyro"
		bodyGyro.P = config.Rotation.P
		bodyGyro.D = config.Rotation.D
		bodyGyro.MaxTorque = config.Rotation.MaxTorque
		bodyGyro.CFrame = root.CFrame
		bodyGyro.Parent = root
	end
	local context: NPCContext = {
		npc = npc,
		humanoid = humanoid,
		root = root,
		head = head,
		animator = getAnimator(humanoid),
		animationCache = {},
		currentTrack = nil,
		state = "",
		ammo = 0,
		reloading = false,
		lastShotTime = 0,
		target = nil,
		path = path,
		flashTag = npc:FindFirstChild("Flashed"),
		pathAccumulator = 0,
		targetAccumulator = 0,
		bodyGyro = bodyGyro,
	}
	REG[npc] = context
	setState(context, "Idle", true)
	humanoid.Died:Connect(function()
		handleNPCDeath(npc, humanoid)
	end)
end

function Controller.Start(npcOrList)
	if typeof(npcOrList) == "Instance" then
		if npcOrList:IsA("Model") then
			registerNPC(npcOrList)
		elseif npcOrList:IsA("Folder") then
			for _, child in ipairs(npcOrList:GetChildren()) do
				if child:IsA("Model") then
					registerNPC(child)
				end
			end
		end
	elseif typeof(npcOrList) == "table" then
		for _, npc in ipairs(npcOrList) do
			if typeof(npc) == "Instance" and npc:IsA("Model") then
				registerNPC(npc)
			end
		end
	else
		error("Start expects a Model, Folder, or array of Models")
	end
	ensureHeartbeat()
end

return Controller
