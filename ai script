function run()

	local lastHealth = npchumanoid.Health

	npchumanoid.HealthChanged:Connect(function(newHealth)
		if newHealth < lastHealth then
			lastHealth = newHealth
			local dorun = math.random(1, 1)
			if dorun == 1 and not walking then
				if following then return end
				print("Damage detected, attempting to find cover...")
				local cover, coverPos = findNearestCover()
				if cover and coverPos then
					print("yup cover")
					Path:Stop()
					Running = true
					Path.Visualize = true
					shooting = false
					canshoot = false
					walking = true
					npchumanoid.WalkSpeed = 28

					local reachedConn
					reachedConn = Path.Reached:Connect(function()
						reachedConn:Disconnect()
						--Running = false
						shooting = false
						canshoot = true
						walking = false
						npchumanoid.WalkSpeed = 16
						local coverSize = cover.Size
						local coverPos = cover.Position
						local peekOffsets = {
							Vector3.new(coverSize.X / 2 + 2, 0, 0),   -- Right
							Vector3.new(-coverSize.X / 2 - 2, 0, 0),  -- Left
							Vector3.new(0, 0, coverSize.Z / 2 + 2),   -- Front
							Vector3.new(0, 0, -coverSize.Z / 2 - 2),  -- Back
						}

						local rayParams = RaycastParams.new()
						rayParams.FilterDescendantsInstances = {npc, cover}
						rayParams.FilterType = Enum.RaycastFilterType.Blacklist

						for _, offset in ipairs(peekOffsets) do
							local peekPos = coverPos + offset
							local direction = (peekPos - npc.PrimaryPart.Position).Unit * 10
							local result = workspace:Raycast(npc.PrimaryPart.Position, direction, rayParams)

							if not result then
								print("peeking")
								Path:Run(peekPos)
							else if result then
									Running = false
								end
								break
							end
						end
					end)

					Path:Run(coverPos)
				end
			end
		else
			lastHealth = newHealth
		end
	end)
end
function dashAI(npc, directionVector)
	if not npc or not npc:FindFirstChild("HumanoidRootPart") or not npc:FindFirstChildOfClass("Humanoid") then
		warn("Invalid NPC or missing components for dash.")
		return
	end
	local npchumanoid = npc:FindFirstChildOfClass("Humanoid")
	local rootPart = npc:FindFirstChild("HumanoidRootPart")
	local slideAnim = Instance.new("Animation")
	slideAnim.AnimationId = "rbxassetid://101766464614422" 
	local playAnim = npchumanoid:LoadAnimation(slideAnim)
	playAnim:Play()
	local slide = Instance.new("BodyVelocity")
	slide.MaxForce = Vector3.new(1, 0, 1) * 35000 
	slide.Velocity = directionVector.Unit * 100 
	slide.Parent = rootPart
	for count = 1, 8 do
		wait(0.1)
		slide.Velocity *= 0.7
	end
	slide:Destroy()
	playAnim:Stop() 
end
local followedTarget = nil
local followedHumanoid = nil
local followOffsetTarget = nil
local hasDashedOnTargetDeath = false
local lastFollowedHumanoid = nil
function balls()
	local Backing = true
	if npcFlash.Value or following then return end

	while true do
		if shooting then
			Path:Stop()
		elseif not npcFlash.Value then
			if npchumanoid and npchumanoid.Health > 0 then
				if followedTarget and followedHumanoid and followedHumanoid.Health > 0 then
					lastFollowedHumanoid = followedHumanoid
					hasDashedOnTargetDeath = false 

					if followOffsetTarget and followOffsetTarget.PrimaryPart then
						local offsetPos = followOffsetTarget.PrimaryPart.Position + followOffsetTarget.PrimaryPart.CFrame.LookVector * -5
						Path:Run(offsetPos)
					else
						Path:Stop()
					end
				else
					if lastFollowedHumanoid and lastFollowedHumanoid.Health <= 0 and not hasDashedOnTargetDeath then
						hasDashedOnTargetDeath = true
						following = false
						local dashForce = 1000
						local randomDirection = Vector3.new(math.random(-100, 100), 0, math.random(-100, 100))
						randomDirection = randomDirection.Unit * dashForce
						dashAI(npc, randomDirection)
					end
					--print("test")

					followedTarget = nil
					followedHumanoid = nil
					followOffsetTarget = nil
					lastFollowedHumanoid = nil

					local retreatPos, torso = getback()
					if retreatPos and torso then
						local potentialTarget = torso.Parent
						local follower1 = potentialTarget:FindFirstChild("Follower1")
						local follower2 = potentialTarget:FindFirstChild("Follower2")

						if follower1 and follower1:IsA("ObjectValue") and not follower1.Value then
							follower1.Value = npc
							following = true
							followedTarget = potentialTarget
							followedHumanoid = potentialTarget:FindFirstChildOfClass("Humanoid")
							followOffsetTarget = potentialTarget
							lastFollowedHumanoid = followedHumanoid
							hasDashedOnTargetDeath = false

							if potentialTarget.PrimaryPart then
								local offsetPos = potentialTarget.PrimaryPart.Position + potentialTarget.PrimaryPart.CFrame.LookVector * -5
								Path:Run(offsetPos)
							end
						elseif follower2 and follower2:IsA("ObjectValue") and not follower2.Value and follower1 and follower1.Value then
							follower2.Value = npc
							following = true
							followedTarget = potentialTarget
							followedHumanoid = potentialTarget:FindFirstChildOfClass("Humanoid")
							followOffsetTarget = follower1.Value
							lastFollowedHumanoid = followedHumanoid
							hasDashedOnTargetDeath = false

							if followOffsetTarget.PrimaryPart then
								local offsetPos = followOffsetTarget.PrimaryPart.Position + followOffsetTarget.PrimaryPart.CFrame.LookVector * -5
								Path:Run(offsetPos)
							end
						else
							local nearestCharacter = GetNearestCharacter(npc.PrimaryPart.Position)
							if nearestCharacter and nearestCharacter.PrimaryPart then
								Backing = false
								Path:Run(nearestCharacter.PrimaryPart)
							else
								Path:Stop()
							end
						end
					else
						local nearestCharacter = GetNearestCharacter(npc.PrimaryPart.Position)
						if nearestCharacter and nearestCharacter.PrimaryPart then
							Backing = false
							Path:Run(nearestCharacter.PrimaryPart)
						else
							Path:Stop()
						end
					end
				end
			else
				break
			end
		end
		task.wait()
	end
end

