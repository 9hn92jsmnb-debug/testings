local function canSeeTarget(npc, targetCharacter)
	local head = npc.Head
	local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter:FindFirstChild("Head")
	if not head or not targetRoot then
		return false
	end
	local direction = (targetRoot.Position - head.Position).unit
	local distance = (targetRoot.Position - head.Position).magnitude
	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = {npc} 
	raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
	local result = workspace:Raycast(head.Position, direction * distance, raycastParams)
	if result then
		--print("Blocked by:", result.Instance.Name)  
		return result.Instance:IsDescendantOf(targetCharacter)  
	end
	return true  
end

local function findNearestCover()
	local origin = torso.Position
	local maxDistance = 100
	local nearestTarget = nil
	local shortestDistance = maxDistance

	for _, model in ipairs(workspace:GetDescendants()) do
		if model:IsA("Model") and model:FindFirstChild("Humanoid") and model:FindFirstChild("HumanoidRootPart") then
			local mercenaryTag = model:FindFirstChild("Corporation")
			if not (mercenaryTag and mercenaryTag:IsA("BoolValue") and mercenaryTag.Value == true) then
				local distance = (origin - model.HumanoidRootPart.Position).Magnitude
				if distance < shortestDistance then
					shortestDistance = distance
					nearestTarget = model
				end
			end
		end
	end

	local minCoverDistanceFromTarget = 10
	if not nearestTarget then return nil end

	local targetPart = nearestTarget:FindFirstChild("Head") or nearestTarget:FindFirstChild("HumanoidRootPart")
	if not targetPart then return nil end

	local bestCover = nil
	local bestCoverDistance = maxDistance
	local bestCoverPosition = nil

	for _, part in ipairs(workspace:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide and part.Transparency < 1 and part ~= torso and part ~= targetPart then
			local model = part:FindFirstAncestorWhichIsA("Model")
			if model and model:FindFirstChildOfClass("Humanoid") and model:FindFirstChild(part.Name) == part then
				continue
			end
			if part.Size.X < torso.Size.X or part.Size.Y < torso.Size.Y then
				continue
			end
			if (part.Position - targetPart.Position).Magnitude < minCoverDistanceFromTarget then
				continue
			end
			if part.Position.Y < torso.Position.Y - 10 then
				continue
			end
			if part.Position.Y > torso.Position.Y + 20 then
				continue
			end

			local toCover = (part.Position - targetPart.Position).Unit
			local fromCoverToNPC = (origin - part.Position).Unit

			local rayParams = RaycastParams.new()
			rayParams.FilterDescendantsInstances = {npc, nearestTarget}
			rayParams.FilterType = Enum.RaycastFilterType.Blacklist
			rayParams.IgnoreWater = true

			local rayToCover = workspace:Raycast(targetPart.Position, toCover * maxDistance, rayParams)
			local rayToNPC = workspace:Raycast(part.Position, fromCoverToNPC * maxDistance, rayParams)

			if rayToCover and rayToCover.Instance == part and (not rayToNPC or rayToNPC.Instance ~= targetPart) then
				local distance = (origin - part.Position).Magnitude
				if distance < bestCoverDistance then
					bestCoverDistance = distance
					bestCover = part
					print(bestCover.Name)
					local coverNormal = (part.Position - targetPart.Position).Unit
					bestCoverPosition = part.Position + coverNormal * (part.Size.Magnitude / 2 + 1)
				end
			end
		end
	end

	if bestCover and bestCoverPosition then
		return bestCover, bestCoverPosition
	end

	return nil
end

local function GetNearestCharacter(fromPosition)
	if npcFlash.Value then return end
	local character, dist = nil, math.huge
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character and player.Character.PrimaryPart then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			local cloaked = player.Character:FindFirstChild("Cloaked")
			local Ally = player.Character:FindFirstChild("Corporation")
			if not Ally then
				Ally = Instance.new("BoolValue")  
				Ally.Name = "Corporation"               
				
					Ally.Value = false
				          
				Ally.Parent = player.Character               
				print("Created Ally tag for:", player.Name)
			end
			if humanoid and humanoid.Health > 0 and not (cloaked and cloaked.Value) and not Ally.Value then 
				local distance = (player.Character.PrimaryPart.Position - fromPosition).Magnitude
				if distance < dist then
					character, dist = player.Character, distance
				end
			end
		end
	end
	return character
end
local function getback()
	local lowestHealth = math.huge
	local selectedTorso, selectedPos
	for _, model in ipairs(workspace:GetChildren()) do
		if model ~= npc 
			and model:IsA("Model") 
			and model.Name ~= npc.Name 
			and model.Name == "Corporation shielder"
			and model:FindFirstChild("Corporation") then

			local corpTag = model:FindFirstChild("Corporation")
			if corpTag:IsA("BoolValue") and corpTag.Value then
				local humanoid = model:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					local torso = model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
					if torso and torso:IsA("BasePart") then
						if (npc.PrimaryPart.Position - torso.Position).Magnitude <= 50 then
							if humanoid.Health < lowestHealth then
								lowestHealth = humanoid.Health
								selectedTorso = torso
								selectedPos = torso.Position + torso.CFrame.LookVector * -5
							end
						end
					end
				end
			end
		end
	end
	if selectedTorso and selectedPos then
		return selectedPos, selectedTorso
	end
	return nil
end
